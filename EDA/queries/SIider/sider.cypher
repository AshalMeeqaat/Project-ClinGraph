///////////////////////////////////////////////////////////////////////////
// SIDER KNOWLEDGE GRAPH
///////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////
// CONSTRAINTS
///////////////////////////////////////////////////////////////////////////

CREATE CONSTRAINT drug_id IF NOT EXISTS
FOR (d:Drug)
REQUIRE d.id IS UNIQUE;

CREATE CONSTRAINT disease_id IF NOT EXISTS
FOR (d:Disease)
REQUIRE d.id IS UNIQUE;

CREATE CONSTRAINT sideeffect_id IF NOT EXISTS
FOR (s:SideEffect)
REQUIRE s.id IS UNIQUE;

///////////////////////////////////////////////////////////////////////////
// LOAD DRUGS
///////////////////////////////////////////////////////////////////////////

LOAD CSV WITH HEADERS
FROM 'file:///Drug.csv' AS row

MERGE (d:Drug {id:row.id})
SET d.name=row.name;

///////////////////////////////////////////////////////////////////////////
// LOAD DISEASES
///////////////////////////////////////////////////////////////////////////

LOAD CSV WITH HEADERS
FROM 'file:///Disease.csv' AS row

MERGE (d:Disease {id:row.id})
SET d.name=row.name;

///////////////////////////////////////////////////////////////////////////
// LOAD SIDE EFFECTS
///////////////////////////////////////////////////////////////////////////

LOAD CSV WITH HEADERS
FROM 'file:///SideEffect.csv' AS row

MERGE (s:SideEffect {id:row.id})
SET s.name=row.name;

///////////////////////////////////////////////////////////////////////////
// LOAD HAS_SIDE_EFFECT
///////////////////////////////////////////////////////////////////////////

LOAD CSV WITH HEADERS
FROM 'file:///HAS_SIDE_EFFECT.csv' AS row

MATCH (d:Drug {id:row.source})
MATCH (s:SideEffect {id:row.target})

MERGE (d)-[:HAS_SIDE_EFFECT]->(s);

///////////////////////////////////////////////////////////////////////////
// LOAD TREATS
///////////////////////////////////////////////////////////////////////////

LOAD CSV WITH HEADERS
FROM 'file:///TREATS.csv' AS row

MATCH (d:Drug {id:row.source})
MATCH (di:Disease {id:row.target})

MERGE (d)-[:TREATS]->(di);

///////////////////////////////////////////////////////////////////////////
// VERIFY
///////////////////////////////////////////////////////////////////////////

MATCH (n)
RETURN labels(n)[0] AS NodeType,
count(*) AS Count
ORDER BY Count DESC;

MATCH ()-[r]->()
RETURN type(r) AS Relationship,
count(*) AS Count;